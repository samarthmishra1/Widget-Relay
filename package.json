{
  "name": "widget-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "android:init": "npm run build && cap add android && node scripts/install-android.mjs && cap sync android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:init": "npm run build && cap add ios && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --test tests/*.test.js",
    "security:check": "python3 scripts/check-public.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
